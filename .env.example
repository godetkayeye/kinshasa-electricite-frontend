# URL de l'API Laravel, sans slash final. Exemple local : http://127.0.0.1:8000/api
NEXT_PUBLIC_API_URL=

# URL publique du site (facultatif en local), utilisée pour les aperçus de partage. Exemple : https://exemple.cd
NEXT_PUBLIC_SITE_URL=

# Administration : URL de l'API Laravel vue depuis le serveur Next.js (facultatif).
# Par défaut, NEXT_PUBLIC_API_URL est utilisée. Exemple : http://127.0.0.1:8000/api
API_INTERNAL_URL=
